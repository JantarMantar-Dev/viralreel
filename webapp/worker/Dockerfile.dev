FROM node:20-bookworm

# Install dependencies for Remotion (SKIPPED - Need to view file first) and ffmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files for the worker
COPY worker/package*.json ./worker/

# Install dependencies
WORKDIR /app/worker
RUN npm install


# Copy source code
WORKDIR /app
COPY shared/ ./shared/
COPY worker/ ./worker/

WORKDIR /app/worker


# Start command (overridden in compose for watch)
CMD ["npm", "start"]
